{
  "_about": "규칙 SSOT. 에이전트·scripts/gate.py 모두 이 파일만 참조한다. 원문: docs/design.md, harness/r3-criteria.md, harness/r5-gates.md",
  "version": 1,

  "tokens": {
    "colors": {
      "ink": "#141414",
      "ink-soft": "#262626",
      "canvas": "#ffffff",
      "canvas-soft": "#f3f3f3",
      "field": "#f0f0f0",
      "hairline-soft": "#f0f0f0",
      "hairline": "#e0e0e0",
      "text-muted": "#707070",
      "text-faint": "#adadad",
      "accent": "#0066ff"
    },
    "overlay_colors": [
      { "name": "badge-overlay", "hex": "#737373", "opacity": 0.56, "_note": "design.md badge-overlay rgba(115,115,115,0.56) — 사진 위 배지 전용" }
    ],
    "radius": [0, 16, 24, 9999],
    "squircle": { "layer_pattern": "app-icon", "ratio": 0.3, "tolerance_px": 1 },
    "font_family": "Pretendard",
    "font_weights": [300, 400, 600, 700],
    "letter_spacing": 0,
    "spacing": [0, 4, 8, 12, 16, 24, 32, 48, 64]
  },

  "layer_patterns": {
    "_about": "레이어 이름(소문자) 부분일치 정규식. 디자이너 에이전트는 레이어 이름을 이 규칙에 맞춘다.",
    "button": "button|btn|cta",
    "text_input": "text-input|input|field",
    "card": "card",
    "asset_card": "asset-card"
  },

  "gates": {
    "G1": {
      "file": "1-reference/references.json",
      "rules": {
        "G1-1": { "desc": "레퍼런스 총 개수", "equals": 15, "per_keyscreen": 5 },
        "G1-2": { "desc": "필수 필드 누락", "required_fields": ["app", "ui_url", "screen_type", "point", "keyscreen"] },
        "G1-3": { "desc": "같은 앱 최대 개수", "max_per_app": 3 }
      }
    },
    "G2": {
      "file": "2-analysis/points.json",
      "rules": {
        "C2-1": { "desc": "키스크린별 반영 포인트 수", "min": 3, "max": 5 },
        "C2-2": { "desc": "PRD 근거 번호", "pattern": "^\\d+-\\d+$" },
        "C2-3": { "desc": "출처 ui_url 이 references.json 안에 있음" },
        "C2-4": { "desc": "MVP 제외 키워드", "keywords": ["허들링 픽", "결제", "정산", "피드백", "구매"] }
      }
    },
    "G3": {
      "files": ["3-spec/screen-spec.md", "3-spec/required-layers.json", "3-spec/flows.json"],
      "rules": {
        "G3-1": { "desc": "3개 파일 존재" },
        "G3-2": { "desc": "K1~K3 필수 레이어 각 1개 이상" },
        "CX-3": { "ref": "CX-3" }
      }
    },
    "G4": {
      "file": "4-keyscreen/snapshot.json",
      "rules": {
        "C4-1": { "desc": "프레임 크기", "width": 390, "height": 844, "screens": ["K1", "K2", "K3"] },
        "C4-2": { "desc": "설계서 필수 레이어 존재", "source": "3-spec/required-layers.json" },
        "C4-3": { "desc": "K2 공개 범위 옵션", "screen": "K2", "texts": ["비공개", "멤버 공개", "판매 신청"] },
        "C4-4": { "desc": "K2 판매 신청 상태", "screen": "K2", "texts": ["임시저장", "검수 대기", "수정 요청", "승인됨", "반려"] },
        "C4-5": { "desc": "K3 판매 기준 체크리스트 8항목 (PRD 6-7)", "screen": "K3",
                  "keywords": ["실제 업무", "결과 예시", "사용 방법", "초보자", "환경", "개인정보", "저작권", "바로 써볼"] },
        "C4-6": { "desc": "K3 액션 버튼", "screen": "K3", "button_texts": ["승인", "수정 요청", "반려"] },
        "CX-1": { "ref": "CX-1" },
        "CX-2": { "ref": "CX-2" }
      }
    },
    "G5": {
      "file": "5-concept/approval.json",
      "rules": {
        "G5-1": { "desc": "승인 필드", "required_fields": ["approver", "date", "chosen"] },
        "G5-2": { "desc": "진입 조건: G4 pass 이며 CX = 0" }
      }
    },
    "G6": {
      "files": ["6a-system/tokens.json", "6a-system/components.json"],
      "rules": {
        "G6-1": { "desc": "tokens·components 의 모든 값이 tokens 허용값 안에 있음" }
      }
    },
    "G7": {
      "file": "6b-screens/snapshot.json",
      "rules": {
        "T-1": { "desc": "색상은 tokens.colors / overlay_colors 만" },
        "T-2": { "desc": "radius 는 tokens.radius, app-icon 은 squircle 30%" },
        "T-3": { "desc": "폰트 패밀리는 Pretendard 만" },
        "T-4": { "desc": "폰트 굵기는 tokens.font_weights 만" },
        "T-5": { "desc": "자간 0" },
        "T-6": { "desc": "간격(itemSpacing, padding)은 tokens.spacing 만" },
        "A-1": { "desc": "액센트 색 화면당 최대 개수", "max_per_screen": 2 },
        "A-2": { "desc": "버튼 fill 에 액센트 색", "max": 0 },
        "C7-1": { "desc": "그림자 0개 (예외 레이어만 허용)", "allowed_layer_patterns": ["segmented-control-active"] },
        "C7-2": { "desc": "#f0f0f0 fill 은 입력창 레이어에서만", "color": "#f0f0f0" },
        "C7-3": { "desc": "#f0f0f0 1px stroke 는 카드 레이어에서만", "color": "#f0f0f0" },
        "C7-4": { "desc": "카드에 ink fill(색 반전) 금지", "color": "#141414" },
        "CX-1": { "ref": "CX-1" },
        "CX-2": { "ref": "CX-2" }
      }
    }
  },

  "cx": {
    "_about": "어기면 안 되는 것 (docs/story-service.md). 1건이라도 → 즉시 fail, G5 진입 차단.",
    "CX-1": {
      "desc": "더미 텍스트 개인정보·기밀 패턴",
      "patterns": {
        "email": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
        "phone": "01\\d-?\\d{3,4}-?\\d{4}",
        "rrn": "\\d{6}-?[1-4]\\d{6}"
      },
      "company_names": ["삼성전자", "현대자동차", "LG전자", "SK텔레콤", "쿠팡"],
      "_company_note": "실존 회사명 목록 — 운영하며 추가"
    },
    "CX-2": {
      "desc": "승인됨이 아닌 자산 카드에 '판매 중' 또는 가격 노출",
      "non_approved_status": ["임시저장", "검수 대기", "수정 요청", "반려"],
      "sale_markers": ["판매 중"],
      "price_pattern": "(\\d{1,3}(,\\d{3})+|\\d+)\\s*원|₩\\s*\\d"
    },
    "CX-3": {
      "desc": "판매 신청 → 승인됨 경로 중 운영자 검수를 거치지 않는 경로",
      "sale_request_node": "sale_request",
      "review_node": "admin_review",
      "terminal_nodes": ["approved", "for_sale"]
    }
  },

  "retry": { "max_attempts": 3 }
}
